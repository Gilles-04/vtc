# Variables d'environnement attendues — voir docs/02-architecture-technique.md
# Ce fichier documente les NOMS de variables uniquement, jamais leurs valeurs.
# .env n'est jamais versionné (voir .gitignore).
#
# Le préfixe EXPO_PUBLIC_ est requis par Expo pour inliner une variable dans
# le bundle client (https://docs.expo.dev/guides/environment-variables/) —
# ce sont les mêmes valeurs publiques que VITE_SUPABASE_* dans apps/web/
# apps/admin, jamais la clé service_role.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Même clé client Google Maps que apps/web (VITE_GOOGLE_MAPS_API_KEY) —
# Places API (New) + Maps JavaScript API, restreinte par referrer HTTP.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Identifiant du projet Expo (expo.dev) — indispensable à
# getExpoPushTokenAsync (voir src/lib/pushNotifications.ts). Obtenu via
# `npx eas init` (compte Expo gratuit) une fois, jamais fabriqué. Sans
# cette valeur, l'enregistrement du jeton push est ignoré silencieusement
# (pas d'erreur) — les notifications ne partent jamais.
EXPO_PUBLIC_PROJECT_ID=

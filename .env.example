# Variables d'environnement attendues — voir docs/02-architecture-technique.md
# Ce fichier documente les NOMS de variables uniquement, jamais leurs valeurs.
# .env n'est jamais versionné (voir .gitignore).

# --- Supabase (projet dédié à ce produit, distinct de tout autre projet) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cartographie (Google Maps, décidé le 3 septembre 2026) ---
# Clé SERVEUR, Directions API uniquement, AUCUNE restriction de referrer
# (appelée depuis l'Edge Function pricing-directions, jamais un navigateur)
# — secret Supabase (Dashboard → Edge Functions → Secrets), jamais dans un
# fichier .env versionné ou non. La clé CLIENT (Places API (New) + Maps
# JavaScript API, restreinte par referrer) vit dans apps/web/.env.example
# et apps/mobile/.env.example (VITE_GOOGLE_MAPS_API_KEY /
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY) — jamais celle-ci.
GOOGLE_MAPS_API_KEY=

# --- SMS / OTP (eSMS Africa — compte distinct de tout autre projet) ---
ESMS_AFRICA_API_KEY=
ESMS_AFRICA_VERIFY_APP_ID=

# --- Paiement Mobile Money (aucun fournisseur câblé au MVP — voir docs/10-paiements.md) ---
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=

# --- Notifications push (Expo) ---
EXPO_PUBLIC_PROJECT_ID=

# --- Supervision ---
MONITORING_WEBHOOK_URL=

# --- Worker de dispatch (services/matching-worker/, processus à part) ---
# Connexion Postgres directe, PAS les clés ci-dessus (voir
# services/matching-worker/.env.example).
# SUPABASE_DB_URL=

# Variables d'environnement attendues — voir docs/02-architecture-technique.md
# Ce fichier documente les NOMS de variables uniquement, jamais leurs valeurs.
# .env n'est jamais versionné (voir .gitignore).

# --- Supabase (projet dédié à ce produit, distinct de tout autre projet) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cartographie (voir docs/02-architecture-technique.md — décision à confirmer) ---
GOOGLE_MAPS_API_KEY=

# --- SMS / OTP (eSMS Africa — compte distinct de tout autre projet) ---
ESMS_AFRICA_API_KEY=
ESMS_AFRICA_VERIFY_APP_ID=

# --- Paiement Mobile Money (aucun fournisseur câblé au MVP — voir docs/10-paiements.md) ---
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=

# --- Notifications push (Expo) ---
EXPO_PUBLIC_PROJECT_ID=

# --- Supervision ---
MONITORING_WEBHOOK_URL=

# --- Worker de dispatch (services/matching-worker/, processus à part) ---
# Connexion Postgres directe, PAS les clés ci-dessus (voir
# services/matching-worker/.env.example).
# SUPABASE_DB_URL=

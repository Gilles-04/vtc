# Connexion Postgres directe (Supabase → Project Settings → Database →
# Connection string — mode "Session", recommandé pour un processus
# long-vécu plutôt que le pooler "Transaction"). Jamais les clés
# anon/service_role de l'API REST : ce worker parle SQL en direct, pas
# HTTP.
SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Intervalle de balayage en millisecondes (défaut 5000 = 5 s). À garder
# nettement sous le délai d'expiration d'une offre (15 s, voir
# docs/08-matching.md) pour que l'attente perçue par le passager reste
# courte.
MATCHING_WORKER_INTERVAL_MS=5000
